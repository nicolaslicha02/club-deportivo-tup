<div class="d-flex justify-content-between align-items-center mb-4">
  <h2>Listado de Socios</h2>
  <%= link_to 'Nuevo Socio', new_admin_member_profile_path, class: 'btn btn-primary' %>
</div>

<div class="card shadow-sm">
  <table class="table table-hover mb-0">
    <thead class="table-light">
      <tr>
        <th>Foto</th>
        <th>Nombre y Apellido</th>
        <th>DNI</th>
        <th>Nº de Socio</th>
      </tr>
    </thead>
    <tbody>
      <% @profiles.each do |profile| %>
        <tr>
          <td class="align-middle">
            <% if profile.avatar.attached? %>
              <%= image_tag profile.avatar, style: "width: 50px; height: 50px; object-fit: cover; border-radius: 50%;" %>
            <% else %>
              <span class="text-muted" style="font-size: 0.85em;">Sin foto</span>
            <% end %>
          </td>
          <td class="align-middle"><%= profile.first_name %> <%= profile.last_name %></td>
          <td class="align-middle"><%= profile.dni %></td>
          <td class="align-middle"><%= profile.member_number %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>