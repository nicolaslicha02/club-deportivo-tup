<div class="d-flex justify-content-between align-items-center mb-4">
  <h2>Gestión de Cobros y Cuotas</h2>
</div>

<div class="card shadow-sm">
  <div class="card-body p-0">
    <table class="table table-hover mb-0">
      <thead class="table-dark">
        <tr>
          <th>Socio</th>
          <th>DNI</th>
          <th>Vencimiento</th>
          <th>Monto</th>
          <th>Estado</th>
          <th>Comprobante</th>
          <th>Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% @fees.each do |fee| %>
          <tr>
            <!-- 1. Socio -->
            <td class="align-middle">
              <%= fee.member_profile.first_name %> <%= fee.member_profile.last_name %>
              <br>
              <small class="text-muted"><%= fee.member_profile.member_number %></small>
            </td>
            
            <!-- 2. DNI -->
            <td class="align-middle"><%= fee.member_profile.dni %></td>
            
            <!-- 3. Vencimiento -->
            <td class="align-middle"><%= fee.due_date.strftime("%d/%m/%Y") if fee.due_date %></td>
            
            <!-- 4. Monto -->
            <td class="align-middle fw-bold">$<%= fee.amount %></td>
            
            <!-- 5. Estado -->
            <td class="align-middle">
              <% case fee.status.to_s %>
              <% when 'pending', '0' %>
                <span class="badge bg-warning text-dark">Pendiente</span>
              <% when 'paid', '1' %>
                <span class="badge bg-info text-dark">A Revisar</span>
              <% when 'approved', '2' %>
                <span class="badge bg-success">Aprobado</span>
              <% else %>
                <span class="badge bg-secondary"><%= fee.status.present? ? fee.status : "Sin estado" %></span>
              <% end %>
            </td>

            <!-- 6. Comprobante -->
            <td class="align-middle">
              <% if fee.receipt.attached? %>
                <%= link_to "Ver Archivo", url_for(fee.receipt), target: "_blank", class: "btn btn-sm btn-outline-primary" %>
              <% else %>
                <span class="text-muted small">Sin archivo</span>
              <% end %>
            </td>

            <!-- 7. Acciones -->
            <td class="align-middle">
              <div class="btn-group">
                <%= button_to "Aprobar", admin_membership_fee_path(fee, status: 'approved'), method: :patch, class: "btn btn-sm btn-success", form: { data: { turbo: false } } %>
                <%= button_to "Rechazar", admin_membership_fee_path(fee, status: 'pending'), method: :patch, class: "btn btn-sm btn-danger", form: { data: { turbo: false } } %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>