<section class="admin-page-heading">
  <div>
    <p class="admin-eyebrow">Administración financiera</p>
    <h1>Cuotas y comprobantes</h1>
    <p class="admin-subtitle">Revisá los comprobantes enviados y dejá una respuesta clara para cada socio.</p>
  </div>
  <span class="admin-heading-icon">$</span>
</section>

<div class="row g-3 mb-4">
  <div class="col-sm-6 col-xl-3">
    <div class="admin-stat-card"><span class="admin-stat-label">A revisar</span><strong><%= @status_counts[:under_review] %></strong><small>Comprobantes recibidos</small></div>
  </div>
  <div class="col-sm-6 col-xl-3">
    <div class="admin-stat-card"><span class="admin-stat-label">Esperando pago</span><strong><%= @status_counts[:pending] %></strong><small>Socios deben enviar comprobante</small></div>
  </div>
  <div class="col-sm-6 col-xl-3">
    <div class="admin-stat-card"><span class="admin-stat-label">Rechazados</span><strong><%= @status_counts[:rejected] %></strong><small>Pueden corregirse y reenviarse</small></div>
  </div>
  <div class="col-sm-6 col-xl-3">
    <div class="admin-stat-card"><span class="admin-stat-label">Aprobados</span><strong><%= @status_counts[:approved] %></strong><small>Pagos confirmados</small></div>
  </div>
</div>

<div class="admin-filter-bar mb-3">
  <%= link_to "Todas (#{@status_counts[:all]})", admin_membership_fees_path, class: "admin-filter-link #{'active' unless params[:status].present?}" %>
  <%= link_to "A revisar", admin_membership_fees_path(status: :under_review), class: "admin-filter-link #{'active' if params[:status] == 'under_review'}" %>
  <%= link_to "Esperando pago", admin_membership_fees_path(status: :pending), class: "admin-filter-link #{'active' if params[:status] == 'pending'}" %>
  <%= link_to "Rechazados", admin_membership_fees_path(status: :rejected), class: "admin-filter-link #{'active' if params[:status] == 'rejected'}" %>
  <%= link_to "Aprobados", admin_membership_fees_path(status: :approved), class: "admin-filter-link #{'active' if params[:status] == 'approved'}" %>
</div>

<div class="card admin-card">
  <div class="table-responsive">
    <table class="table admin-table align-middle mb-0">
      <thead>
        <tr>
          <th>Socio</th>
          <th>Cuota</th>
          <th>Estado</th>
          <th>Comprobante</th>
          <th class="admin-review-column">Revisión</th>
        </tr>
      </thead>
      <tbody>
        <% @fees.each do |fee| %>
          <tr>
            <td>
              <div class="fw-semibold"><%= fee.member_profile.first_name %> <%= fee.member_profile.last_name %></div>
              <div class="small text-muted"><%= fee.member_profile.member_number %> · DNI <%= fee.member_profile.dni %></div>
            </td>
            <td>
              <div class="fw-bold"><%= number_to_currency(fee.amount, unit: "$", precision: 0, delimiter: ".") %></div>
              <div class="small text-muted">Vence <%= l(fee.due_date, format: "%d/%m/%Y") if fee.due_date %></div>
            </td>
            <td>
              <% case fee.status %>
              <% when "pending" %><span class="admin-status status-pending">Esperando pago</span>
              <% when "under_review" %><span class="admin-status status-review">A revisar</span>
              <% when "approved" %><span class="admin-status status-approved">Aprobada</span>
              <% when "rejected" %><span class="admin-status status-rejected">Rechazada</span>
              <% end %>
            </td>
            <td>
              <% if fee.receipt.attached? %>
                <%= link_to "Abrir comprobante ↗", url_for(fee.receipt), target: "_blank", rel: "noopener", class: "btn btn-sm btn-outline-primary" %>
              <% else %>
                <span class="text-muted small">Todavía no enviado</span>
              <% end %>
            </td>
            <td class="admin-review-column">
              <% if fee.under_review? && fee.receipt.attached? %>
                <%= form_with url: admin_membership_fee_path(fee), method: :patch, local: true, class: "admin-review-form" do |form| %>
                  <%= form.label :review_note, "Motivo si rechazás", class: "form-label small fw-semibold" %>
                  <%= form.text_area :review_note, rows: 2, maxlength: 1000, placeholder: "Ej.: el comprobante no muestra el monto", class: "form-control form-control-sm mb-2" %>
                  <div class="d-flex gap-2">
                    <%= form.button "Aprobar", name: :decision, value: "approve", class: "btn btn-sm btn-success flex-fill" %>
                    <%= form.button "Rechazar", name: :decision, value: "reject", class: "btn btn-sm btn-outline-danger flex-fill" %>
                  </div>
                  <small class="text-muted d-block mt-2">El motivo es obligatorio al rechazar.</small>
                <% end %>
              <% elsif fee.rejected? %>
                <div class="small text-danger fw-semibold">Motivo</div>
                <div class="small"><%= fee.review_note %></div>
                <div class="small text-muted mt-1">El socio puede reenviar el comprobante.</div>
              <% elsif fee.reviewed_at.present? %>
                <span class="small text-muted">Revisada el <%= l(fee.reviewed_at, format: "%d/%m/%Y") %></span>
              <% else %>
                <span class="small text-muted">Sin acciones pendientes</span>
              <% end %>
            </td>
          </tr>
        <% end %>
        <% if @fees.empty? %>
          <tr><td colspan="5" class="text-center text-muted py-5">No hay cuotas para este filtro.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
