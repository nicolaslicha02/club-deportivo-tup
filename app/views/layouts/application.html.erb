<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Club Deportivo" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Club Deportivo">
    <meta name="mobile-web-app-capable" content="yes">
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% if request.path.start_with?('/admin') && request.path != '/admin/login' %>
      <nav class="admin-navbar">
        <div class="admin-navbar-inner">
          <%= link_to admin_root_path, class: "admin-brand" do %>
            <span class="admin-brand-mark">CD</span>
            <span><strong>Club Deportivo</strong><small>Administración</small></span>
          <% end %>
          <div class="admin-nav-links">
            <%= link_to "Actividades", admin_activities_path, class: (request.path.start_with?(admin_activities_path) ? "active" : nil) %>
            <%= link_to "Socios", admin_member_profiles_path, class: (request.path.start_with?(admin_member_profiles_path) ? "active" : nil) %>
            <%= link_to "Cuotas y pagos", admin_membership_fees_path, class: (request.path.start_with?(admin_membership_fees_path) ? "active" : nil) %>
            <%= link_to "Configuración", edit_admin_club_setting_path, class: (request.path.start_with?(edit_admin_club_setting_path) ? "active" : nil) %>
          </div>
          <div class="admin-nav-account">
            <span><%= current_admin&.email %></span>
            <%= button_to "Salir", admin_logout_path, method: :delete, class: "btn btn-sm btn-outline-light" %>
          </div>
        </div>
      </nav>

    <% elsif request.path.start_with?('/portal') %>
      <nav class="member-navbar">
        <div class="container member-navbar-inner">
          <%= link_to portal_dashboard_path, class: "member-brand" do %>
            <span class="member-brand-mark">CD</span><span><strong>Club Deportivo</strong><small>Portal de socios</small></span>
          <% end %>
          <div class="member-nav-links">
            <%= link_to "Mi panel", portal_dashboard_path, class: (request.path == portal_dashboard_path ? "active" : nil) %>
            <%= link_to "Actividades", portal_activities_path, class: (request.path.start_with?(portal_activities_path) ? "active" : nil) %>
          </div>
          <div class="member-nav-account">
            <span><%= current_user&.email %></span>
            <%= button_to "Salir", logout_path, method: :delete, class: "member-logout" %>
          </div>
        </div>
      </nav>

    <% else %>
      <!-- Barra Pública (Registro / Login) -->
      <nav class="navbar navbar-expand-lg navbar-light bg-light mb-4 shadow-sm">
        <div class="container">
          <a class="navbar-brand fw-bold" href="/">Club Deportivo</a>
          <div class="d-flex">
            <%= link_to "Iniciar Sesión", login_path, class: "btn btn-outline-primary me-2" %>
            <%= link_to "Hacete Socio", registro_path, class: "btn btn-primary" %>
          </div>
        </div>
      </nav>
    <% end %>

    <main class="<%= request.path.start_with?('/admin') && request.path != '/admin/login' ? 'container-fluid admin-main' : 'container mt-4' %>">
      <!-- Sistema de mensajes flash globales -->
      <% if flash[:notice] %>
        <div class="alert alert-success alert-dismissible fade show <%= 'no-print' if request.path.start_with?('/portal/membership_fees/') && request.path.end_with?('/coupon') %>" role="alert">
          <%= flash[:notice] %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% end %>
      
      <% if flash[:alert] %>
        <div class="alert alert-danger alert-dismissible fade show <%= 'no-print' if request.path.start_with?('/portal/membership_fees/') && request.path.end_with?('/coupon') %>" role="alert">
          <%= flash[:alert] %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
