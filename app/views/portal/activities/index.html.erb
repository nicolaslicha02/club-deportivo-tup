<section class="member-section member-activities-page">
  <div class="member-section-heading">
    <div><p class="member-eyebrow">SUMATE AL CLUB</p><h1>Actividades disponibles</h1><p>Encontrá una propuesta para vos. El importe se suma a tu cuota mensual.</p></div>
    <%= link_to "← Mi panel", portal_dashboard_path, class: "member-text-link" %>
  </div>

  <% if @available_activities.any? %>
    <div class="member-available-grid">
      <% @available_activities.each do |activity| %>
        <article class="member-available-card">
          <div class="member-available-mark"><%= activity.name.first.upcase %></div>
          <h2><%= activity.name %></h2>
          <p><%= activity.description.presence || "Consultá con el club para conocer los detalles de esta actividad." %></p>
          <div class="member-available-meta">
            <span><small>Adicional mensual</small><strong><%= number_to_currency(activity.monthly_fee, unit: "$", precision: 0, delimiter: ".") %></strong></span>
            <span><small>Cupos disponibles</small><strong><%= activity.available_spots %></strong></span>
          </div>
          <%= button_to "Inscribirme", enroll_portal_activity_path(activity), method: :post, class: "member-primary-button w-100", data: { turbo: false } %>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="member-empty-state"><strong>Por ahora no hay actividades disponibles</strong><p>Ya estás inscripto en todas las actividades activas con cupo.</p><%= link_to "Volver a mi panel", portal_dashboard_path, class: "member-primary-button" %></div>
  <% end %>
</section>
