<div class="row">
  <div class="col-md-12">
    <h2 class="mb-4">Bienvenido, <%= @profile.first_name %> <%= @profile.last_name %></h2>
  </div>
</div>

<div class="row">
  <div class="col-md-6">
    <div class="card mb-4 shadow-sm">
      <div class="card-header bg-primary text-white">
        <h5 class="mb-0">Mis Datos</h5>
      </div>
      <div class="card-body">
        <p class="mb-1"><strong>N° de Socio:</strong> <%= @profile.member_number %></p>
        <p class="mb-0"><strong>DNI:</strong> <%= @profile.dni %></p>
      </div>
    </div>

    <div class="card mb-4 shadow-sm">
      <div class="card-header bg-info text-white">
        <h5 class="mb-0">Mis Actividades</h5>
      </div>
      <ul class="list-group list-group-flush">
        <% if @activities.any? %>
          <% @activities.each do |activity| %>
            <li class="list-group-item d-flex justify-content-between align-items-center">
              <%= activity.name %>
              <span class="badge bg-secondary rounded-pill">$<%= activity.monthly_fee %></span>
            </li>
          <% end %>
        <% else %>
          <li class="list-group-item text-muted">No estás inscripto en ninguna actividad.</li>
        <% end %>
      </ul>
      <div class="card-footer bg-white border-0">
        <%= link_to "Inscribirse a nuevas actividades", portal_activities_path, class: "btn btn-outline-info btn-sm w-100" %>
      </div>
    </div>
  </div>

  <div class="col-md-6">
    <div class="card shadow-sm border-warning">
      <div class="card-header bg-warning text-dark">
        <h5 class="mb-0">Estado de Cuenta</h5>
      </div>
      <div class="card-body">
        <% if @pending_fees.any? %>
          <h6 class="text-muted border-bottom pb-2 mb-3">Cuotas Pendientes</h6>
          <% @pending_fees.each do |fee| %>
            <%= form_with(model: fee, url: portal_membership_fee_path(fee), method: :patch, local: true, html: { multipart: true }) do |f| %>
              <div class="mb-3 p-3 bg-light rounded border">
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <span>Vencimiento: <strong><%= fee.due_date.strftime("%d/%m/%Y") if fee.due_date %></strong></span>
                  <span class="fs-5 fw-bold text-danger">$<%= fee.amount %></span>
                </div>
                <%= f.file_field :receipt, class: "form-control form-control-sm mb-2", required: true, accept: "image/png, image/jpeg, application/pdf" %>
                <%= f.submit "Subir Comprobante y Abonar", class: "btn btn-sm btn-success w-100" %>
              </div>
            <% end %>
          <% end %>
        <% else %>
          <div class="alert alert-success mb-0">
            ¡Estás al día con tus cuotas!
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>