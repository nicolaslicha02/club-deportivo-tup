<div class="row mt-5">
  <div class="col-md-6 offset-md-3">
    <div class="card shadow">
      <div class="card-header bg-primary text-white text-center">
        <h3 class="mb-0">Hacete Socio</h3>
      </div>
      <div class="card-body p-4">
        <% if @user.errors.any? %>
          <div class="alert alert-danger">
            <ul class="mb-0">
              <% @user.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <%= form_with(model: @user, url: registro_path, data: { turbo: false }) do |form| %>
          
          <h5 class="border-bottom pb-2 mb-3">Datos de Acceso</h5>
          <div class="mb-3">
            <%= form.label :email, "Correo Electrónico", class: "form-label" %>
            <%= form.email_field :email, class: "form-control", required: true %>
          </div>
          <div class="mb-4">
            <%= form.label :password, "Contraseña", class: "form-label" %>
            <%= form.password_field :password, class: "form-control", required: true %>
          </div>

          <h5 class="border-bottom pb-2 mb-3">Datos Personales</h5>
          <%= form.fields_for :member_profile do |profile_form| %>
            <div class="row">
              <div class="col-md-6 mb-3">
                <%= profile_form.label :first_name, "Nombre", class: "form-label" %>
                <%= profile_form.text_field :first_name, class: "form-control", required: true %>
              </div>
              <div class="col-md-6 mb-3">
                <%= profile_form.label :last_name, "Apellido", class: "form-label" %>
                <%= profile_form.text_field :last_name, class: "form-control", required: true %>
              </div>
            </div>

            <div class="row">
              <div class="col-md-6 mb-3">
                <%= profile_form.label :dni, "DNI", class: "form-label" %>
                <%= profile_form.text_field :dni, class: "form-control", required: true %>
              </div>
              <div class="col-md-6 mb-3">
                <%= profile_form.label :birth_date, "Fecha de Nacimiento", class: "form-label" %>
                <%= profile_form.date_field :birth_date, class: "form-control", required: true %>
              </div>
            </div>

            <div class="mb-4">
              <%= profile_form.label :avatar, "Sube una foto para tu carnet", class: "form-label" %>
              <%= profile_form.file_field :avatar, class: "form-control", accept: "image/*" %>
            </div>
          <% end %>

          <div class="d-grid">
            <%= form.submit "Crear Cuenta", class: "btn btn-primary btn-lg" %>
          </div>
        <% end %>

      </div>
    </div>
  </div>
</div>